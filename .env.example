# AI Chatbot Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# AI Provider API Keys (at least one required)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# ===========================================
# AI Model Configuration
# ===========================================
# Default model options:
#   Anthropic: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5
#   OpenAI: gpt-6-sol, gpt-5.6-terra, gpt-6-luna, gpt-5.6-luna, gpt-4.1-mini, gpt-4o-mini
AI_DEFAULT_MODEL=claude-haiku-4-5

# Max output tokens per response (cost control)
AI_MAX_TOKENS=2048

# Token budget for the conversation history sent with each request, estimated
# at ~4 characters per token. Newest messages are kept whole, older ones are
# dropped or truncated. System prompt and tool definitions come on top.
AI_CONTEXT_MAX_TOKENS=8000
# Deprecated and ignored since AI_CONTEXT_MAX_TOKENS replaced them:
# AI_CONTEXT_RECENT_MESSAGES, AI_CONTEXT_MAX_OLDER_CHARS

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
APP_DEBUG=true

# ===========================================
# Rate Limits (protect your API budget!)
# ===========================================
# Hourly: AI requests in any 60-minute window (0 = unlimited)
# Daily: messages per calendar day (server time zone)
# Daily tokens: input + output + cache tokens per day (0 = unlimited). Checked
# before each request, so the request that crosses the limit still completes.
RATE_LIMIT_GUEST_HOURLY=10
RATE_LIMIT_GUEST_DAILY=20
RATE_LIMIT_GUEST_DAILY_TOKENS=0
RATE_LIMIT_USER_HOURLY=30
RATE_LIMIT_USER_DAILY=100
RATE_LIMIT_USER_DAILY_TOKENS=0
