{
    "name": "app/ai-chatbot",
    "description": "AI Chatbot - PHP/Swoole/Mezzio/Datastar implementation",
    "type": "project",
    "license": "MIT",
    "require": {
        "ext-openswoole": "^26.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "php": "^8.5",
        "mbolli/php-via": "@dev",
        "parsedown/parsedown": "^1.7",
        "ramsey/uuid": "^4.7",
        "starfederation/datastar-php": "^1.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "ext-inotify": "*",
        "friendsofphp/php-cs-fixer": "^3.67",
        "mockery/mockery": "^1.6",
        "openswoole/ide-helper": "^26.2",
        "pestphp/pest": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roave/security-advisories": "dev-latest",
        "tomasvotruba/type-coverage": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php bin/server.php"
        ],
        "test": "pest",
        "test:coverage": "pest --coverage",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "db:init": "php bin/init-db.php",
        "db:migrate": "php bin/migrate.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "RC",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../php-via-fix",
            "options": {
                "symlink": true
            }
        }
    ]
}
